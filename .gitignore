# Ignore image data folder completely
data/

# Ignore heavy 3D reconstruction files
*.ply
*.pcd
*.obj

# Ignore saved reconstruction runs and viewpoint files (regenerated by incremental_sfm.ipynb)
*.pkl
*.npz

# Ignore model weights (YOLO downloads them automatically on first use)
*.pt

# Ignore Python cache and environment files
__pycache__/
*.pyc
.env

# Ignore Jupyter and editor/OS clutter
.ipynb_checkpoints/
.vscode/
.DS_Store